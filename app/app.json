{
  "expo": {
    "name": "AfterCare",
    "slug": "aftercare",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aftercare",
    "userInterfaceStyle": "light",
    "backgroundColor": "#06283d",
    "primaryColor": "#06283d",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.aftercare.app",
      "buildNumber": "1",
      "usesAppleSignIn": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "AfterCare can lock the app with Face ID so only you can open it. Crisis help (988) still works without unlocking.",
        "NSUserNotificationsUsageDescription": "AfterCare sends optional check-in reminders after a Panic plan and gentle quest nudges. You can turn these off in system Settings.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "tel",
          "sms",
          "mailto",
          "https",
          "http"
        ]
      },
      "associatedDomains": [
        "applinks:aftercare-biniam1211s-projects.vercel.app"
      ],
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": []
      }
    },
    "android": {
      "package": "ai.aftercare.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#06283d"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "aftercare-biniam1211s-projects.vercel.app",
              "pathPrefix": "/api/auth/verify"
            },
            {
              "scheme": "https",
              "host": "aftercare-biniam1211s-projects.vercel.app",
              "pathPrefix": "/app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "appUrl": "https://aftercare-biniam1211s-projects.vercel.app/app",
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#06283d",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#06283d",
          "defaultChannel": "aftercare-reminders"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "AfterCare can lock the app with Face ID so only you can open it. Crisis help (988) still works without unlocking."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "./plugins/withPrivacyManifest.js"
    ]
  }
}
