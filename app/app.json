{
  "expo": {
    "name": "AfterCare",
    "slug": "aftercare",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aftercare",
    "userInterfaceStyle": "light",
    "backgroundColor": "#06283d",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.aftercare.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.aftercare.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#06283d"
      },
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "appUrl": "https://aftercare-biniam1211s-projects.vercel.app/app"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#06283d"
        }
      ]
    ]
  }
}
