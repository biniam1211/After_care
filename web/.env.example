# AfterCare web — environment
# Copy to .env.local and fill in. .env* is gitignored.
#
# The app runs end-to-end with ZERO env vars (localStorage + scripted chat).
# Fill these in for production features. See docs/PRODUCTION-READINESS.md.

# ── Required in production once accounts / cron / magic links are enabled ──

# Canonical public site URL. Required in production when DATABASE_URL is set
# (pins magic-link hosts; never trust Host headers alone).
# APP_URL=https://aftercare.example.org

# Protects /api/cron/reminders (Bearer only). Required in production when
# DATABASE_URL is set — cron fails closed without it.
# CRON_SECRET=

# ── AI chat ──

# Claude API key. When set, the AI Chat uses the live Claude API.
# When unset, the app falls back to built-in scripted replies (still a full demo).
# Crisis detection still runs client-side and injects 988 / Covenant / Trevor.
ANTHROPIC_API_KEY=

# Optional: override the model. Defaults to claude-opus-5.
# For a high-volume, cost-sensitive deployment, claude-sonnet-5 or claude-haiku-4-5
# are good choices.
# ANTHROPIC_MODEL=claude-sonnet-5

# ── Email (Resend) ──

# Sends caseworker emails (Panic Button + resources) and magic-link sign-in.
# Caseworker email only sends for signed-in users with caseworkerEmail saved
# server-side — the client cannot choose an arbitrary recipient.
RESEND_API_KEY=
# From address for Resend. Use a verified domain in production.
# RESEND_FROM=AfterCare <hello@yourdomain.org>

# ── Database (optional — enables accounts + cross-device sync) ──

# Postgres — enables cross-device sync + magic-link sign-in. When unset, the app
# persists to localStorage only (still a full demo). The schema is created
# automatically on first use.
DATABASE_URL=
# Set to "false" only for a local Postgres without SSL.
# DATABASE_SSL=false

# ── Optional integrations ──

# Sanity CMS — when set, the resource directory is served from Sanity (GROQ) so
# non-devs can edit it; otherwise the bundled seed is used. Read-only.
# National crisis lines (988 / Covenant / Trevor) are pinned and cannot have
# their phone numbers overwritten by CMS.
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
# SANITY_TOKEN=            # only needed for a private dataset
# SANITY_API_VERSION=v2021-10-21

# Betterstack (Logtail) — structured server logs. Unset = errors to console only.
# Never logs message content, names, or emails.
# BETTERSTACK_SOURCE_TOKEN=
# BETTERSTACK_INGEST_URL=https://in.logs.betterstack.com
