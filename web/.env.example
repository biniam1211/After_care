# AfterCare web — environment
# Copy to .env.local and fill in. .env* is gitignored.

# Claude API key. When set, the AI Chat uses the live Claude API.
# When unset, the app falls back to built-in scripted replies (still a full demo).
ANTHROPIC_API_KEY=

# Optional: override the model. Defaults to claude-opus-5.
# For a high-volume, cost-sensitive deployment, claude-sonnet-5 or claude-haiku-4-5
# are good choices.
# ANTHROPIC_MODEL=claude-sonnet-5

# Resend — sends the "text my caseworker" emails (Panic Button + resources) and
# the magic-link sign-in emails. When unset, those actions are simulated
# (the UI still confirms "sent") so the demo works with no config.
RESEND_API_KEY=
# From address for Resend. Use a verified domain in production.
# RESEND_FROM=AfterCare <hello@yourdomain.org>

# Postgres — enables cross-device sync + magic-link sign-in. When unset, the app
# persists to localStorage only (still a full demo). The schema is created
# automatically on first use.
DATABASE_URL=
# Set to "false" only for a local Postgres without SSL.
# DATABASE_SSL=false
# Canonical site URL used to build sign-in links (falls back to request host).
# APP_URL=https://aftercare.example.org
